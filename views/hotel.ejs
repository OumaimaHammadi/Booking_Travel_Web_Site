<input
  type="text"
  class="form-control"
  id="arrival"
  name="Arrivee"
  placeholder="Arrival (JJ/MM/AAAA)"
  required
>

<input
  type="text"
  class="form-control"
  id="departure"
  name="Departure"
  placeholder="Departure (JJ/MM/AAAA)"
  required
>
<script>
  flatpickr("#arrival", {
    locale: "fr",
    altInput: true,
    altFormat: "d/m/Y",
    dateFormat: "Y-m-d"
  });

  flatpickr("#departure", {
    locale: "fr",
    altInput: true,
    altFormat: "d/m/Y",
    dateFormat: "Y-m-d"
  });
</script>


            

              <input type="hidden" class="form-control" placeholder="Number of Nights" name="NbreNuit" value="Departure - Arrivee" required>
              <input type="number" class="form-control" placeholder="Number of Adults"  name="NbreAdult" required>
              <input type="number" class="form-control" placeholder="Number of Children"  name="NbreEnfant" required>
              <input type="number" class="form-control" placeholder="Child Age"  name="ChildAge" required>
              <input type="number" class="form-control" placeholder="Number of Rooms" name="NbreChambre" required>
                 
              <input type="hidden" name="name" value="<%= hotel.name %>">
              <input type="hidden" name="price" value="<%= hotel.price %>">
              <input type="hidden" name="hotelId" value="<%= hotel._id%>">
              <input type="hidden" name="image" value="<%=hotel.image %>">
  
  
              
              <input type="hidden" name="PrixAllinclusive" value="<%= hotel.PrixAllinclusive %>">
              <input type="hidden" name="PrixDemiPension" value="<%= hotel.PrixDemiPension %>">
              <input type="hidden" name="PrixpetitDejeuner" value="<%= hotel.PrixpetitDejeuner %>">
  
  
  
              <!-- <input type="hidden" name="redirectTo" value="/hotel/<%= hotel._id%>"> -->
             
  
                    
  
  
  
  
           
            <textarea class="form-control" rows="5" name="text" placeholder="Enter Your Name & Details"></textarea>
              <input type="submit" value ="CONTINUE YOUR BOOKING " class=" btn btn-primary">     
          
  
          </form>

          </div>
    

        </div>






      </div>




      <div class="col-md-6 py-3 py-md-0">
        <div class="card ">
          <div class="card-body">


            
        <h1><span><%=hotel.name %></span></h1>
        <h6>  <i class='fas fa-map-marker-alt'></i>
          <%= hotel.category %></h6>

        <div class="star">
          <i class="fa-solid fa-star checked"></i>
          <i class="fa-solid fa-star checked"></i>
          <i class="fa-solid fa-star checked"></i>
          <i class="fa-solid fa-star checked "></i>
          <i class="fa-solid fa-star "></i>
        </div>


        <h2>Price/person :<strong> <%= hotel.price %> DT</strong></h2>

        <p> <strong >Details about <%=hotel.name %>:<br></strong>
          <%= hotel.description %> </p>

            
          </div>

     

        </div>
      </div>
    </div>

    <% } %>


  </div>









