

/* =========================================================
   TABLETTE
   max-width: 1024px
========================================================= */

@media (max-width: 1024px) {

    #navbar {
        padding: 8px 15px;
    }

    #logo {
        font-size: 30px;
        margin-right: 25px;
    }

    .navbar-nav {
        gap: 2px;
    }

    .nav-item .nav-link {
        font-size: 15px;
        padding: 8px 9px;
        letter-spacing: 0.5px;
    }

    .avatar-circle {
        width: 42px;
        height: 42px;
    }

    .initials {
        font-size: 18px;
    }
}


/* =========================================================
   MOBILE
   max-width: 991px
========================================================= */

@media (max-width: 991px) {

    #navbar {
        padding: 8px 15px;
    }

    #navbar .container-fluid {
        flex-wrap: wrap;
    }


    /* Logo + bouton */

    #logo {
        font-size: 30px;
        margin-right: 0;
    }

    #navbar .navbar-toggler {
        margin-left: auto;
    }


    /* Menu */

    #mynavbar {
        width: 100%;
        margin-top: 10px;
        padding: 10px 0;
    }

    .navbar-nav {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 3px;
        margin-left: 0;
    }

    .nav-item {
        width: 100%;
        margin: 0;
    }

    .nav-item .nav-link {
        width: 100%;
        display: block;
        text-align: left;

        font-size: 16px;
        padding: 11px 15px;

        border-radius: 6px;
    }


    /* Profile */

    #navbar > .container-fluid > .navbar-collapse > form {
        width: 100%;
        margin: 10px 0 0 0;
        justify-content: flex-start;
    }

    #profileDropdown {
        display: flex;
        align-items: center;
    }

    .avatar-circle {
        width: 45px;
        height: 45px;
    }


    /* Dropdown */

    .dropdown-menu {
        position: absolute;
        min-width: 230px;
    }
}


/* =========================================================
   PETIT MOBILE
   max-width: 576px
========================================================= */

@media (max-width: 576px) {

    #navbar {
        padding: 7px 10px;
    }

    #logo {
        font-size: 26px;
    }

    #navbar .navbar-toggler {
        padding: 6px 10px;
    }

    #navbar .navbar-toggler i {
        font-size: 20px;
    }

    #mynavbar {
        margin-top: 8px;
    }

    .nav-item .nav-link {
        font-size: 15px;
        padding: 10px 12px;
    }

    .avatar-circle {
        width: 42px;
        height: 42px;
    }

    .initials {
        font-size: 18px;
    }

    .dropdown-menu {
        min-width: 210px;
        font-size: 15px;
    }

    .dropdown-item {
        font-size: 15px !important;
        padding: 9px;
    }
}


/* =========================================================
   TRÈS PETIT ÉCRAN
   max-width: 400px
========================================================= */

@media (max-width: 400px) {

    #logo {
        font-size: 23px;
    }

    #navbar {
        padding: 6px 8px;
    }

    #navbar .navbar-toggler {
        padding: 5px 9px;
    }

    #navbar .navbar-toggler i {
        font-size: 18px;
    }

    .nav-item .nav-link {
        font-size: 14px;
        padding: 9px 10px;
    }

    .dropdown-menu {
        min-width: 195px;
    }
}

