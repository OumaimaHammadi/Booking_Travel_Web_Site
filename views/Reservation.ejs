<%- include('parts/header') %>
<%- include('parts/navbar') %>

<link rel="stylesheet" href="/reservation.css">




<section class="pre-booking" id="pre-booking">




<div class="reservation-container">
<% if(items.length === 0) { %>
    <p class="alert alert-danger">There are no reservation.</p>

<% } else {  %>

    

    <table class="table">
        <thead>
            <th> N° </th> 
            <th> User </th> 
            <th> Email </th> 


            <th>Hotel name</th>
            <th>Price/Person</th>
            <th>Arrival</th>
            <th>Departure</th>

            <th>Night(s)</th>
            <th>Room(s) </th>            

            <th>Adult(s)</th>
            <th>Children</th>
            <th>Child Age</th>

       


         
            <!-- <th> Supplément</th> -->
            <th> Subtotal</th>

            <th>   </th>
            <th>   </th>
        </thead>
    <tbody>
        <% if(  validationError ){ %>
            <p class="alert alert-danger">
              <%= validationError.msg %>
            </p>
            <% } %>
       

      <%  for ( let i = 0 ; i< items.length ;  i++) {  %>
        

        <tr>
            <td data-label="N°"> <%= i+1 %> </td>
            <td data-label=" Username"> <%= items[i].userId.username %></td>
            <td data-label="Email"> <%= items[i].userId.email %></td>


            <td data-label="Hotel name"><%= items[i].name %> </td>
            <td data-label="Price/Personne"><%= items[i].price %> dt</td>
            <td data-label="Arrival">   <%= items[i].Arrivee%></td>
            <td data-label="Departure">   <%= items[i].Departure%></td>

             <td data-label="Nights"> <%= (items[i].Departure - items[i].Arrivee)/ (1000 * 60 * 60 * 24)%></td>
             <td data-label="Room(s)"><%= items[i].NbreChambre%> 
             </td>
            <td data-label="Adult(s)"> <%= items[i].NbreAdult%> </td>
            <td data-label="Child"> <%= items[i].NbreEnfant%> </td>
           <td data-label="Age Child"> <%= items[i].ChildAge %> Years</td>
               <td data-label="Subtotal" name = "Subtotal"   value="<%= items[i].price * items[i].NbreChambre * (items[i].Departure - items[i].Arrivee)/ (1000 * 60 * 60 * 24) %>"><%= items[i].price * items[i].NbreChambre * (items[i].Departure - items[i].Arrivee)/ (1000 * 60 * 60 * 24)%> Dt</td>



       

                

         

            <form  method="POST">
               
   



               
<td>

    <div class="boutons">

    <input type="hidden" name="cardId" value="<%= items[i]._id %>" >
    <input type="submit"  class="btn btn-success"   value ="Modify" formaction="/hotel/<%=items[i]._id %>" >
    <input type="submit"  class="btn btn-danger"   value ="Delete" formaction="/reservation/delete">
    <!-- <input type="submit"  class="btn btn-danger"   value ="Delete All" formaction="/pre-booking/deleteAll"> -->
 


   </div>

</td>
            </form>  
            <td>
                <form action="/booking" method="POST" class="Add-to-cart-form">

                    <input type="hidden" name="name" value="<%= items[i].name %>"> 
                    <input type="hidden" name="price" value="<%= items[i].price %>" >
                    <input type="hidden" name="image"  value=" <%= items[i].image %>">


                    <input type="hidden" name="Arrivee" value="<%= items[i].Arrivee %>">
                    <input type="hidden" name="Departure" value="<%= items[i].Departure %>">

                    <input type="hidden" name="NbreNuit" value="<%= (items[i].Departure - items[i].Arrivee)/ (1000 * 60 * 60 * 24)%>">
                    <input type="hidden" name="NbreChambre" value="<%= items[i].NbreChambre %>">
                    <input type="hidden" name="NbreAdult" value="<%= items[i].NbreAdult %>">
                    <input type="hidden" name="NbreEnfant" value="<%= items[i].NbreEnfant %>">
                    <input type="hidden" name="ChildAge" value="<%= items[i].ChildAge %>">

<input type="hidden" name="Subtotal"   value="<%= items[i].price * items[i].NbreChambre * (items[i].Departure - items[i].Arrivee)/ (1000 * 60 * 60 * 24) %>">




                    <input type="hidden" name="PrixAllinclusive"    value="<%= items[i].PrixAllinclusive %>">
                    <input type="hidden" name="PrixDemiPension"     value="<%= items[i].PrixDemiPension %>">
                    <input type="hidden" name="PrixpetitDejeuner"   value="<%= items[i].PrixpetitDejeuner %>"> 





                <div class="bouton_reserver">
                    <input type="hidden" name="cardId" value="<%= items[i]._id%>">
                    <input type="submit"  class="btn btn-primary"   value ="To book" >

                </div>


                  
      
            </form>

           

</td>

            
            </div>
            

        </tr>
        <% } %>
    </tbody>
    </table>
    <% } %>
</div>


</section>

<%- include('parts/footer') %>
