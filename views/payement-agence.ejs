<%- include('parts/header') %>
<%- include('parts/navbar') %>


<link rel="stylesheet" href="/payement-agence.css">




<section class="payement-agence" id="payement-agence">

<div class="container">


<div class="row" >


<div class="col-md-6 py-3 py-md-0">

 


           <div class="card">
  <!-- <img src="/photos/djerba.PNG" alt="Hotel"> -->
    <img src="/photos/1692148234545-Mouradi club kantaoui.PNG" alt="Hotel">

                <!-- <img src="/<%=item.image %>" alt=""> -->


  <div class="main-text">
      <h1>Arrival: <span><%= item.Arrivee %></span></h1>
    <h1>Departure: <span><%= item.Departure %></span></h1>
    
    <h1>Hotel Name: <span><%= item.name %></span></h1>
    <h1>Price: <span><%= item.price %> dt</span></h1>

  

    <h1>Night(s): <span><%= item.NbreNuit %></span></h1>
    <h1>Room(s): <span><%= item.NbreChambre %></span></h1>
    <h1>Adult(s): <span><%= item.NbreAdult %></span></h1>
    <h1>Children: <span><%= item.NbreEnfant %></span></h1>
    <h1>Supplement: <span><%= item.supplement %></span></h1>
    <h1>Total: <span><%= item.total %> dt</span></h1>


    
  </div>
</div>





     </div>

<!--Coordonée & Agence-->
  
   
      
        <div class="col-md-6 py-3 py-md-0">

            <div class="card">
                <div class="coordonnees" >
                    <h1>
                        <i class='far fa-edit'></i>
                   Enter your details        
                    </h1>



                    <form action="/payement-agence" method="POST"  class="form-coordonees">


               
                        <select  name="Civilite" class="form-control" placeholder="civility" class="select">
                         <option value="" >Choose a civility
                         </option>
                         <option value="Mr">Mr </option>
                         <option value="Mme"> Mrs </option>
                         <option value="Mlle"> Miss </option>
                        
               </select>

               <% let CiviliteErrors = validationErrors.find(err => err.param === 'Civilite') %>
                 <% if (CiviliteErrors) { %>
                     <p class="alert alert-danger">
                         <%- CiviliteErrors.msg %>
                     </p>
                 <% } %>
               
             
                 <input type="text" class="form-control" name="Prenom" placeholder="First name" class="input">
                 <% let PrenomErrors = validationErrors.find(err => err.param === 'Prenom') %>
                 <% if (PrenomErrors) { %>
                     <p class="alert alert-danger">
                         <%- PrenomErrors.msg %>
                     </p>
                 <% } %>

                 
                 <input type="text" class="form-control" name="Nom" placeholder="Name">
                 <% let NomErrors = validationErrors.find(err => err.param === 'Nom') %>
                 <% if (NomErrors) { %>
                     <p class="alert alert-danger">
                         <%- NomErrors.msg %>
                     </p>
                 <% } %>

                 
                 <input type="email" class="form-control" name="Email" placeholder="Email">
                 <% let EmailErrors = validationErrors.find(err => err.param === 'Email') %>
                 <% if (EmailErrors) { %>
                     <p class="alert alert-danger">
                         <%- EmailErrors.msg %>
                     </p>
                 <% } %>

                 
                 <input type="tel" class="form-control" name="Portable" placeholder="Phone number">
                 <% let PortableErrors = validationErrors.find(err => err.param === 'Portable') %>
                 <% if (PortableErrors) { %>
                     <p class="alert alert-danger">
                         <%- PortableErrors.msg %>
                     </p>
                 <% } %>
                 <br>

               
        
        
        
                 
             
             
             </form>






                     </div>

                
             </div>

  

     <br>
     
    
    <div class="card">
        <div class="agence" > 
            <h1>       
                <!-- <i class='fas fa-hotel'></i> -->
                <!-- <i class="fa fa-map-marker">       </i> -->
                <i class='fas fa-map-marker-alt'></i>



Select the agency closest to you            </h1>

            <form action="/payement-agence" method="POST"  class="form-agence">


            <select  name="Civilite" class="form-control" placeholder="Civilité">
                    <option value="" > Tunis Agencies    </option>              
                    <option value="Mr"> Lac 1 </option>
                    <option value="Mme"> Lac 2 </option>
                    <option value="Mlle"> Carthage</option>

                
             
               
      </select>


      <select  name="Civilite" class="form-control" placeholder="Civilité">
        <option value="Sousse Agencies" > Sousse Agencies  </option>
        <option value="Sousse City"> Sousse City </option>
        <option value="Hammam Sousse"> Hammam Sousse </option>
        <option value="Shaloul"> Shaloul</option>
       
     </select>


     <select  name="Civilite" class="form-control" placeholder="Civilité">
        <option value="Mahdia Agencies"> Mahdia Agencies
        </option>
        <option value="Mahdia City"> Mahdia City </option>
       
       
     </select>


     <select  name="Civilite" class="form-control" placeholder="Civilité">
        <option value="Kef Agencies" > Kef Agencies
        </option>
        <option value="Kef City"> Kef City </option>
     
       
     </select>



     <select  name="Civilite" class="form-control" placeholder="Civilité">
        <option value=" Beja Agencies " >  Beja Agencies </option>
        <option value="Beja City "> Beja City </option>
      
       
     </select>



     <select  name="Civilite" class="form-control" placeholder="Civilité">
        <option value=" Kasrine Agencies" >  Kasrine Agencies
        </option>
        <option value="Kasrine City"> Kasrine City </option>
      
       
     </select>

            </form>

    
         </div>

    </div>
    <form    action="/thanks" >


    <input type="submit" value="Confirm your booking" class="btn btn-primary btn-lg btn-block">
    </form>
   

        </div>
    
</div>
</div>
      

</section>


<%- include('parts/footer') %>
