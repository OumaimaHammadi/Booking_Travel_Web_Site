
<%- include ('parts/header')%>
<%- include ('parts/navbar')%>

<link rel="stylesheet" href="/hotel.css">









<div class="container">
    <div class="main-txt">
      <!-- <h1>About <span>Us</span></h1> -->
    </div>

    <% if (!hotel) { %>
        <div class="alert alert-danger ">
            there is no hotel
        </div>
    
        <%  } else { %>

    <div class="row" >
      <div class="col-md-6 py-3 py-md-0">
        <% if(  validationError ){ %>
            <p class="alert alert-danger">
              <%= validationError.msg %>
            </p>
            <% } %>

            <div class="card">
              <img src="/<%=hotel.image %>" alt="">

            </div>

        <div class="card">
          <div class="card-one">





            <form action="/reservation" method="POST">
              <!-- <input type="date" class="form-control" placeholder="Arrival" name="Arrivee" required>
              <input type="date" class="form-control" placeholder="Departure" name="Departure" required> -->

              <!-- <input type="date" class="form-control" id="arrival" placeholder="Arrival" name="Arrivee" required>
              <input type="date" class="form-control" id="departure" placeholder="Departure" name="Departure" required>

              <script>
                flatpickr("#arrival", {
                  locale: "fr",
                  dateFormat: "Y-m-d"
                });

                flatpickr("#departure", {
                  locale: "fr",
                  dateFormat: "Y-m-d"
                });
